# ==============================================================================
# VelocIQ Platform — Environment Variables Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite Client-Side)
# Must be prefixed with "VITE_" to be bundled & exposed to the React application
# ------------------------------------------------------------------------------

# [OPTIONAL / HIGHLY RECOMMENDED] Groq Cloud AI API Key
# Powers the VelocIQ Autonomous Telematics AI Copilot (Llama 3.3 70B Versatile).
# Free API keys can be generated at: https://console.groq.com/keys
# Note: If omitted, the app still works 100% and users can enter a key in the UI settings drawer.
VITE_GROQ_API_KEY=gsk_your_groq_api_key_here

# ------------------------------------------------------------------------------
# 2. BACKEND / HOSTING ENVIRONMENT VARIABLES (Render / Node.js Server)
# ------------------------------------------------------------------------------

# [AUTOMATIC ON RENDER] Port for the Express + WebSocket server
# Render automatically injects this port dynamically. Local default is 3000.
PORT=3000

# [RECOMMENDED] Node Runtime Environment
NODE_ENV=production

# [RECOMMENDED FOR RENDER] Node.js Version
# Ensures Render uses Node 20 LTS for modern ES Modules and Vite build tooling
NODE_VERSION=20
